[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	editor = nvim

# Cinematic Noir — presentation only (behavior unchanged)
[color]
	ui = auto
[color "branch"]
	current = "#8B68B5 bold"
	local = "#8B68B5"
	remote = "#6D7291"
[color "diff"]
	meta = "#6D7291"
	frag = "#6672B8 bold"
	old = "#A76565"
	new = "#668B78"
	commit = "#8B68B5"
[color "status"]
	added = "#668B78"
	changed = "#B09A69"
	untracked = "#6F78C4"
	updated = "#6672B8"
	branch = "#8B68B5"
	header = "#6D7291"
	nobranch = "#A76565"
[color "decorate"]
	branch = "#8B68B5"
	remoteBranch = "#6D7291"
	tag = "#B07855"
	stash = "#608D9A"
	HEAD = "#6F78C4 bold"
[color "interactive"]
	prompt = "#6672B8"
	header = "#6D7291"
	help = "#6D7291"
	error = "#A76565"

# Set your identity locally:
#   git config --global user.name "Your Name"
#   git config --global user.email "you@example.com"
