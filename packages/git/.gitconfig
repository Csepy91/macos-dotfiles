[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	editor = nvim

# Personal identity (name/email) — written by ./install.sh, not tracked.
[include]
	path = ~/.gitconfig.local

# Theme colors — generated by `theme apply` (not stowed).
[include]
	path = ~/.config/git/theme.gitconfig

# Identity lives in ~/.gitconfig.local (created by ./install.sh).
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
