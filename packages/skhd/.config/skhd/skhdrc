# App launch / focus (adjust names to match installed apps)
alt - b : open -a "Safari"
alt - return : open -a "Ghostty"
alt - c : open -a "Cursor"
alt - t : open -a "Transmission"
alt - f : open -a "Finder"

# Launcher: OmniWM command palette → Applications tab
# (script: ipcEnabled + Accessibility for osascript)
alt - r : ~/.config/skhd/open-command-palette-applications.sh
