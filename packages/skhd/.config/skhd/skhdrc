# App launch / focus (adjust names to match installed apps)
alt - b : open -a "Safari"
alt - return : open -a "Ghostty"
alt - c : open -a "Cursor"
alt - t : open -a "Transmission"
alt - f : open -a "Finder"

# Launcher (notch panel) — Apps mode / Menu Search
# Requires: ./scripts/install-launcher.sh + Accessibility for Launcher.app
alt - r : ~/.config/skhd/open-launcher.sh
alt - shift - r : ~/.config/skhd/open-launcher-menu.sh

