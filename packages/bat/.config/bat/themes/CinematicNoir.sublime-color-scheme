{
  "name": "CinematicNoir",
  "author": "dotfiles",
  "variables": {
    "base": "#0D0D13",
    "surface": "#161720",
    "surface_alt": "#1D2030",
    "border": "#30344B",
    "fg": "#D0D2DF",
    "muted": "#6D7291",
    "blue": "#6672B8",
    "blue_bright": "#6F78C4",
    "purple": "#8B68B5",
    "amber": "#B07855",
    "red": "#A76565",
    "green": "#668B78",
    "yellow": "#B09A69",
    "cyan": "#608D9A",
    "magenta": "#80639A"
  },
  "globals": {
    "background": "var(base)",
    "foreground": "var(fg)",
    "caret": "var(blue_bright)",
    "block_caret": "var(blue_bright)",
    "line_highlight": "var(surface)",
    "selection": "var(border)",
    "selection_foreground": "var(fg)",
    "selection_border": "var(border)",
    "inactive_selection": "var(surface_alt)",
    "inactive_selection_foreground": "var(muted)",
    "find_highlight": "var(amber)",
    "find_highlight_foreground": "var(base)",
    "guide": "var(border)",
    "active_guide": "var(blue)",
    "stack_guide": "var(surface_alt)",
    "brackets_options": "underline",
    "brackets_foreground": "var(blue_bright)",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "var(purple)",
    "tags_options": "stippled_underline",
    "tags_foreground": "var(cyan)",
    "shadow": "var(base)",
    "shadow_width": 0,
    "gutter": "var(base)",
    "gutter_foreground": "var(muted)",
    "gutter_foreground_highlight": "var(fg)",
    "line_diff_width": 2,
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(yellow)",
    "line_diff_deleted": "var(red)",
    "sublimelinter_mark_style": "outline",
    "sublimelinter_gutter_mark": "var(amber)",
    "minimap_border": "var(border)",
    "accent": "var(blue)",
    "highlight": "var(surface_alt)",
    "highlight_foreground": "var(fg)"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "var(muted)", "font_style": "italic" },
    { "name": "String", "scope": "string", "foreground": "var(green)" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "var(yellow)" },
    { "name": "Constant", "scope": "constant", "foreground": "var(yellow)" },
    { "name": "Built-in constant", "scope": "constant.language", "foreground": "var(amber)" },
    { "name": "Character", "scope": "constant.character", "foreground": "var(green)" },
    { "name": "Keyword", "scope": "keyword, storage.modifier, storage.type", "foreground": "var(purple)" },
    { "name": "Storage", "scope": "storage", "foreground": "var(purple)" },
    { "name": "Operator", "scope": "keyword.operator", "foreground": "var(cyan)" },
    { "name": "Function", "scope": "entity.name.function, support.function, meta.function-call", "foreground": "var(blue_bright)" },
    { "name": "Class", "scope": "entity.name.class, entity.name.type, support.class, support.type", "foreground": "var(blue)" },
    { "name": "Variable", "scope": "variable, variable.other", "foreground": "var(fg)" },
    { "name": "Variable parameter", "scope": "variable.parameter", "foreground": "var(amber)" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "var(blue)" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "var(purple)" },
    { "name": "Library", "scope": "support", "foreground": "var(cyan)" },
    { "name": "Invalid", "scope": "invalid", "foreground": "var(red)" },
    { "name": "Invalid deprecated", "scope": "invalid.deprecated", "foreground": "var(amber)" },
    { "name": "Diff deleted", "scope": "markup.deleted, diff.deleted", "foreground": "var(red)" },
    { "name": "Diff inserted", "scope": "markup.inserted, diff.inserted", "foreground": "var(green)" },
    { "name": "Diff changed", "scope": "markup.changed, diff.changed", "foreground": "var(yellow)" },
    { "name": "Markdown heading", "scope": "markup.heading", "foreground": "var(blue_bright)", "font_style": "bold" },
    { "name": "Markdown link", "scope": "markup.underline.link", "foreground": "var(blue)" },
    { "name": "Markdown bold", "scope": "markup.bold", "font_style": "bold", "foreground": "var(fg)" },
    { "name": "Markdown italic", "scope": "markup.italic", "font_style": "italic", "foreground": "var(fg)" },
    { "name": "Markdown code", "scope": "markup.raw, markup.raw.inline", "foreground": "var(green)" },
    { "name": "Punctuation", "scope": "punctuation", "foreground": "var(muted)" },
    { "name": "JSON key", "scope": "meta.structure.dictionary.key.json string.quoted.double.json", "foreground": "var(blue)" },
    { "name": "YAML key", "scope": "entity.name.tag.yaml", "foreground": "var(blue)" },
    { "name": "Regexp", "scope": "string.regexp", "foreground": "var(cyan)" }
  ]
}
