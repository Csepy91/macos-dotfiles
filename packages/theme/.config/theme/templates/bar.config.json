{
  "theme": {
    "font_family": "SF Pro Text",
    "font_size": 13.0,
    "corner_radius": 0.0,
    "border_width": 0.0,
    "background_color": "{{BASE}}",
    "background_opacity": 0.88,
    "border_color": "{{BLUE_BRIGHT}}",
    "text_color": "{{FG}}",
    "subtext_color": "{{MUTED}}",
    "accent_color": "{{AMBER}}",
    "active_workspace_bg": "{{SURFACE_ALT}}"
  },
  "dimensions": {
    "height": 38,
    "margin_top": 0,
    "padding_horizontal": 12
  },
  "workspaces": {
    "display_type": "pills",
    "show_empty": true,
    "filter_raw_names": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
  }
}
