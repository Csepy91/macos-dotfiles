# Generated by theme apply — palette {{THEME_NAME}}
[color]
	ui = auto
[color "branch"]
	current = "{{PURPLE}} bold"
	local = "{{PURPLE}}"
	remote = "{{MUTED}}"
[color "diff"]
	meta = "{{MUTED}}"
	frag = "{{BLUE}} bold"
	old = "{{RED}}"
	new = "{{GREEN}}"
	commit = "{{PURPLE}}"
[color "status"]
	added = "{{GREEN}}"
	changed = "{{YELLOW}}"
	untracked = "{{BLUE_BRIGHT}}"
	updated = "{{BLUE}}"
	branch = "{{PURPLE}}"
	header = "{{MUTED}}"
	nobranch = "{{RED}}"
[color "decorate"]
	branch = "{{PURPLE}}"
	remoteBranch = "{{MUTED}}"
	tag = "{{AMBER}}"
	stash = "{{CYAN}}"
	HEAD = "{{BLUE_BRIGHT}} bold"
[color "interactive"]
	prompt = "{{BLUE}}"
	header = "{{MUTED}}"
	help = "{{MUTED}}"
	error = "{{RED}}"
