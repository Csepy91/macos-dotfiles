{
  "theme": {
    "font_family": "SF Pro Text",
    "font_size": 12.5,
    "corner_radius": 12.0,
    "border_width": 1.5,
    "background_color": "{{SURFACE}}",
    "background_opacity": 0.10,
    "border_color": "{{BLUE}}",
    "text_color": "{{FG}}",
    "subtext_color": "{{MUTED}}",
    "selection_background": "{{SURFACE_ALT}}",
    "selection_text": "{{BLUE_BRIGHT}}"
  },
  "dimensions": {
    "width": 480,
    "max_height": 540
  },
  "behavior": {
    "hide_on_blur": true,
    "hotkey": "alt+r",
    "clipboard_max_items": 100
  }
}
