    "terminal.ansiCyan": "{{CYAN}}",
    "terminal.ansiWhite": "{{FG}}",
    "terminal.ansiBrightBlack": "{{MUTED}}",
    "terminal.ansiBrightRed": "{{RED}}",
    "terminal.ansiBrightGreen": "{{GREEN}}",
    "terminal.ansiBrightYellow": "{{YELLOW}}",
    "terminal.ansiBrightBlue": "{{BLUE_BRIGHT}}",
    "terminal.ansiBrightMagenta": "{{PURPLE}}",
    "terminal.ansiBrightCyan": "{{CYAN}}",
    "terminal.ansiBrightWhite": "{{FG}}",
    "terminalCursor.foreground": "{{BLUE_BRIGHT}}",

    "gitDecoration.addedResourceForeground": "{{GREEN}}",
    "gitDecoration.modifiedResourceForeground": "{{YELLOW}}",
    "gitDecoration.deletedResourceForeground": "{{RED}}",
    "gitDecoration.untrackedResourceForeground": "{{CYAN}}",
    "gitDecoration.ignoredResourceForeground": "{{MUTED}}",
    "gitDecoration.conflictingResourceForeground": "{{AMBER}}"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{MUTED}}", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": { "foreground": "{{GREEN}}" }
    },
    {
      "name": "Number / Constant",
      "scope": ["constant.numeric", "constant"],
      "settings": { "foreground": "{{YELLOW}}" }
    },
    {
      "name": "Language constant",
      "scope": ["constant.language"],
      "settings": { "foreground": "{{AMBER}}" }
    },
    {
      "name": "Keyword / Storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{PURPLE}}" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "{{CYAN}}" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "{{BLUE_BRIGHT}}" }
    },
    {
      "name": "Class / Type",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": { "foreground": "{{BLUE}}" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "{{FG}}" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "{{AMBER}}" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "{{BLUE}}" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{PURPLE}}" }
    },
    {
      "name": "Library",
      "scope": ["support"],
      "settings": { "foreground": "{{CYAN}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "{{RED}}" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "{{AMBER}}" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "{{RED}}" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "{{GREEN}}" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "diff.changed"],
      "settings": { "foreground": "{{YELLOW}}" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "{{BLUE_BRIGHT}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "{{BLUE}}" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "{{FG}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "{{FG}}", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.raw", "markup.raw.inline"],
      "settings": { "foreground": "{{GREEN}}" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "{{MUTED}}" }
    },
    {
      "name": "JSON key",
      "scope": ["meta.structure.dictionary.key.json string.quoted.double.json"],
      "settings": { "foreground": "{{BLUE}}" }
    },
    {
      "name": "YAML key",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "{{BLUE}}" }
    },
    {
      "name": "Regexp",
      "scope": ["string.regexp"],
      "settings": { "foreground": "{{CYAN}}" }
    }
  ]
}
