#!/bin/sh
# Thin shim: prefer the built app binary, fall back to a PATH-adjacent copy.
set -eu

CANDIDATES="
$HOME/Applications/CalendarBar.app/Contents/MacOS/CalendarBar
/Applications/CalendarBar.app/Contents/MacOS/CalendarBar
"

for bin in $CANDIDATES; do
  if [ -x "$bin" ]; then
    exec "$bin" "$@"
  fi
done

echo "calendar-bar: CalendarBar.app not found. Run: ./scripts/install-calendar-bar.sh" >&2
exit 127
